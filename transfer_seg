import numpy as np
import laspy
from scipy.spatial import cKDTree

def stream_transfer_fixed(
    als_path, tls_path, out_path,
    chunk_size=500_000, k=7, max_dist=0.6,
    semantic_dim="semantic_pred", instance_dim="instance_pred",
    unknown_label=-1, eps=1e-6
):
    als = laspy.read(als_path)

    # Build ALS KD-tree
    als_xyz = np.column_stack((
        np.asarray(als.x, np.float32),
        np.asarray(als.y, np.float32),
        np.asarray(als.z, np.float32),
    ))
    tree = cKDTree(als_xyz)

    if semantic_dim not in als.point_format.dimension_names:
        raise ValueError(f"ALS missing '{semantic_dim}'")
    if instance_dim not in als.point_format.dimension_names:
        raise ValueError(f"ALS missing '{instance_dim}'")

    als_sem = np.asarray(getattr(als, semantic_dim))
    als_ins = np.asarray(getattr(als, instance_dim))

    tls = laspy.read(tls_path)
    n = len(tls.x)

    # Prepare output header: start from TLS header and add extra dims if needed
    out_header = tls.header.copy()
    out_pf = out_header.point_format
    print(out_pf)

    if semantic_dim not in out_pf.dimension_names:
        out_pf = out_pf.add_extra_dimension(laspy.ExtraBytesParams(name=semantic_dim, type=np.int32))
    if instance_dim not in out_pf.dimension_names:
        out_pf = out_pf.add_extra_dimension(laspy.ExtraBytesParams(name=instance_dim, type=np.int64))

    out_header.point_format = out_pf

    with laspy.open(out_path, mode="w", header=out_header) as writer:
        for start in range(0, n, chunk_size):
            end = min(start + chunk_size, n)
            m = end - start

            # Create chunk LasData with correct number of points by slicing the point record
            chunk = laspy.LasData(out_header)
            chunk.points = tls.points[start:end].copy()  # IMPORTANT: size == m

            # Build xyz for this chunk
            pts = np.column_stack((
                np.asarray(tls.x[start:end], np.float32),
                np.asarray(tls.y[start:end], np.float32),
                np.asarray(tls.z[start:end], np.float32),
            ))

            # kNN query
            dists, idx = tree.query(pts, k=k, workers=-1)
            if k == 1:
                dists = dists[:, None]
                idx = idx[:, None]

            ok = dists[:, 0] <= max_dist

            # distance weights
            w = 1.0 / np.maximum(dists, eps)

            sem_neighbors = als_sem[idx]
            ins_neighbors = als_ins[idx]

            # Weighted vote per point (fast-ish, but Python loop; ok for chunking)
            sem_pred = np.empty(m, dtype=np.int32)
            ins_pred = np.empty(m, dtype=np.int64)

            for i in range(m):
                # semantic weighted mode
                labs = sem_neighbors[i]
                ws = w[i]
                uniq, inv = np.unique(labs, return_inverse=True)
                sem_pred[i] = uniq[np.argmax(np.bincount(inv, weights=ws))]

                # instance weighted mode
                labs2 = ins_neighbors[i]
                uniq2, inv2 = np.unique(labs2, return_inverse=True)
                ins_pred[i] = uniq2[np.argmax(np.bincount(inv2, weights=ws))]

            sem_pred[~ok] = unknown_label
            ins_pred[~ok] = unknown_label

            setattr(chunk, semantic_dim, sem_pred)
            setattr(chunk, instance_dim, ins_pred)

            writer.write_points(chunk.points)
            print(f"Wrote {end:,}/{n:,} ({100*end/n:.1f}%)")

    print("Done:", out_path)

